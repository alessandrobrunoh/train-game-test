# Modello LLM "grande" che costruisce il mondo (crate `llm`).
# Copia questo file in `.env` (che resta fuori dal repo) e compila i valori.
# Senza LLM_API_URL l'AI è spenta e il gioco usa i suoi cervelli veloci.
# Le variabili già impostate nella shell hanno la precedenza su questo file.
# Prova la configurazione con: cargo run -p llm --example llm_ping

# URL base di un'API compatibile OpenAI (quella che finisce con /v1).
# Esempi:
#   OpenAI       https://api.openai.com/v1
#   OpenRouter   https://openrouter.ai/api/v1
#   Ollama       http://localhost:11434/v1        (locale, senza chiave)
#   LM Studio    http://localhost:1234/v1         (locale, senza chiave)
LLM_API_URL=https://api.openai.com/v1

# Chiave API. Vuota per i server locali.
LLM_API_KEY=

# Nome del modello, come lo chiama il fornitore.
LLM_MODEL=

# Secondi di attesa massima per una risposta.
LLM_TIMEOUT_SECS=60

# Tetto di chiamate per ora di tempo reale: il limite di spesa. 0 = nessuna chiamata.
LLM_MAX_CALLS_PER_HOUR=120

# Lunghezza massima predefinita di una risposta, in token.
LLM_MAX_TOKENS=800

# Temperatura predefinita (0–2). Commentata: quella del fornitore.
# LLM_TEMPERATURE=0.8

# true se il fornitore supporta response_format json_object (OpenAI sì, altri non sempre).
LLM_JSON_MODE=false

# Nuovi tentativi su limiti di frequenza, sovraccarico ed errori di rete.
LLM_MAX_RETRIES=1
